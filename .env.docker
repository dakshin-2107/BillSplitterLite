# Copy this to .env in the project root (next to docker-compose.yml) and fill in values.

# Required — backend
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — backend flags
BASE_URL=
ALLOW_DEBUG_LOGS=false
ALLOW_INFO_LOGS=true
ALLOW_PANIC_LOGS=true
EXPOSE_EXAMPLE_ENDPOINT=false
AI_PROMPT=
ALLOWED_ORIGINS=

# Optional — host ports (left side of host:container mapping)
BACKEND_PORT=8080
FRONTEND_PORT=3000
REDIS_PORT=6379

# Optional — frontend URLs (change if backend runs on a different host/port)
# These are baked into the frontend at build time.
VITE_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=ws://localhost:8080
VITE_ABOUT_ME_URI=
